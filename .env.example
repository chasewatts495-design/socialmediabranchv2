# ── Database ────────────────────────────────────────────────────────────────
# Leave unset for zero-setup local development: Branch runs an embedded
# Postgres (PGlite) stored in .data/pglite.
# For production, paste your Neon connection string (Neon → Dashboard →
# Connection string):
# DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# ── Security ────────────────────────────────────────────────────────────────
# Password required to open the app. Leave unset to disable the login gate
# (only sensible for local use).
# APP_PASSWORD=choose-a-strong-password

# 32+ char random string. Encrypts stored platform credentials and your
# Anthropic API key at rest. Generate one:  openssl rand -base64 32
# APP_ENCRYPTION_KEY=

# Shared secret for the background-work endpoint (/api/cron/tick).
# Generate one:  openssl rand -hex 24
# CRON_SECRET=

# ── Media storage ───────────────────────────────────────────────────────────
# local  → files stored in .data/uploads (default in dev)
# blob   → Vercel Blob (default in production when BLOB_READ_WRITE_TOKEN is set)
# STORAGE_DRIVER=local
# BLOB_READ_WRITE_TOKEN=

# ── Development helpers ─────────────────────────────────────────────────────
# Runs due scheduled work every 60s inside `next dev` (no cron needed locally).
ENABLE_DEV_TICKER=true

# ── Live platform connections (Phase 2) ─────────────────────────────────────
# Pin the public URL used to build OAuth redirect URIs (recommended in prod;
# falls back to the request's host header when unset).
# APP_BASE_URL=https://your-app.vercel.app

# Developer-app keys can also be pasted in the Connections wizards (stored
# encrypted in the database) — these env vars are an optional fallback.
# PINTEREST_CLIENT_ID=
# PINTEREST_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# META_CONFIG_ID=            # Facebook Login for Business configuration id (fixes "Invalid Scopes")

# Trend Radar: set to 1 to force deterministic demo signals (no live scans).
# TRENDS_FORCE_DEMO=
