              <iframe src="{{ block.settings.video_url }}" title="{{ block.settings.heading | escape }}" style="width:100%;aspect-ratio:16/9;border:0;display:block;" allowfullscreen loading="lazy"></iframe>
            </div>
          {% endif %}
        </div>
      </div>

      {% when 'guarantee' %}
      <div class="cp-band" {{ block.shopify_attributes }}>
        <div class="cp-wrap cp-wrap--narrow">
          <div class="cp-guarantee">
            <div class="cp-seal" aria-hidden="true"><svg viewBox="0 0 44 44" fill="none"><path d="M22 3l15 6v11c0 9.5-6.4 17.4-15 21C13.4 37.4 7 29.5 7 20V9l15-6z" fill="{{ section.settings.color_accent }}"/><path d="M15.5 21.5l4.5 4.5 9-9" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <h2>{{ block.settings.heading }}</h2>
            <p style="margin-bottom:0;">{{ block.settings.body }}</p>
          </div>
        </div>
      </div>

      {% when 'faq_heading' %}
      <div class="cp-band" style="padding-bottom:0;" {{ block.shopify_attributes }}>
        <div class="cp-wrap cp-wrap--narrow cp-center">
          {% if block.settings.eyebrow != blank %}<span class="cp-eyebrow">{{ block.settings.eyebrow }}</span>{% endif %}
          <h2>{{ block.settings.heading }}</h2>
          {% if block.settings.subhead != blank %}<p class="cp-sub">{{ block.settings.subhead }}</p>{% endif %}
        </div>
      </div>

      {% when 'faq_item' %}
      <div class="cp-band" style="padding-top:0;padding-bottom:0;" {{ block.shopify_attributes }}>
        <div class="cp-wrap cp-wrap--narrow">
          <div class="cp-faq">
            <h3>{{ block.settings.question }}</h3>
            {{ block.settings.answer }}
          </div>
        </div>
      </div>

      {% when 'bonus' %}
      <div class="cp-band" {{ block.shopify_attributes }}>
        <div class="cp-wrap cp-wrap--narrow">
          <div class="cp-bonus">
            <span class="cp-free-badge">{{ block.settings.badge }}</span>
            <h2>{{ block.settings.heading }}</h2>
            <p>{{ block.settings.subhead }}</p>
            <p><strong>{{ block.settings.reveal_label }}</strong></p>
            <ol>
              {% assign items = block.settings.items | newline_to_br | split: '<br />' %}
              {% for item in items %}
                {% assign t = item | strip %}
                {% if t != blank %}<li>{{ t }}</li>{% endif %}
              {% endfor %}
            </ol>
            <button type="button" class="cp-cta" data-cp-atc>{{ block.settings.cta_label }}</button>
            {% if block.settings.subline != blank %}<p class="cp-final-sub">{{ block.settings.subline }}</p>{% endif %}
          </div>
        </div>
      </div>

      {% when 'custom_text' %}
      <div class="cp-band" {{ block.shopify_attributes }}>
        <div class="cp-wrap cp-wrap--narrow{% if block.settings.centered %} cp-center{% endif %}">
          {% if block.settings.heading != blank %}<h2>{{ block.settings.heading }}</h2>{% endif %}
          {{ block.settings.body }}
        </div>
      </div>

      {% when 'custom_liquid' %}
      <div {{ block.shopify_attributes }}>{{ block.settings.code }}</div>

    {% endcase %}
  {% endfor %}
</div>

<script>
  (function () {
    var root = document.getElementById('lullo-cp-{{ section.id }}');
    if (!root) return;

    // Move problem cards into their grid (cards are authored as sibling blocks)
    root.querySelectorAll('[data-cp-into]').forEach(function (tpl) {
      var target = root.querySelector('[data-cp-collect="' + tpl.getAttribute('data-cp-into') + '"]');
      if (target) target.appendChild(tpl.content.cloneNode(true));
    });

    var selectedVariant = null;
    var tiers = root.querySelectorAll('[data-cp-tier]');
    function selectTier(btn) {
      tiers.forEach(function (t) { t.setAttribute('aria-pressed', 'false'); });
      btn.setAttribute('aria-pressed', 'true');
      selectedVariant = btn.getAttribute('data-variant-id');
      var p = btn.getAttribute('data-price'), c = btn.getAttribute('data-compare');
      root.querySelectorAll('[data-cp-price]').forEach(function (el) { el.textContent = p; });
      root.querySelectorAll('[data-cp-compare]').forEach(function (el) { el.textContent = c || ''; });
    }
    tiers.forEach(function (t) {
      t.addEventListener('click', function () { selectTier(t); });
      if (t.getAttribute('aria-pressed') === 'true') selectedVariant = t.getAttribute('data-variant-id');
    });

    root.querySelectorAll('[data-cp-atc]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!selectedVariant && tiers.length) selectTier(tiers[0]);
        if (!selectedVariant) return;
        btn.disabled = true;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: parseInt(selectedVariant, 10), quantity: 1 }] })
        }).then(function (r) {
          btn.disabled = false;
          if (r.ok) window.location.href = '/cart';
        }).catch(function () { btn.disabled = false; });
      });
    });
  })();
</script>

