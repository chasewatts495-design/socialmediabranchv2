<script>
  (function () {
    var root = document.getElementById('lullo-cp-{{ section.id }}');
    if (!root) return;

    var selectedVariant = null;
    var tiers = root.querySelectorAll('[data-cp-tier]');
    var priceEls = root.querySelectorAll('[data-cp-price]');
    var compareEls = root.querySelectorAll('[data-cp-compare]');
    var ctaPriceEls = root.querySelectorAll('[data-cp-cta-price]');

    function selectTier(btn) {
      tiers.forEach(function (t) { t.setAttribute('aria-pressed', 'false'); });
      btn.setAttribute('aria-pressed', 'true');
      selectedVariant = btn.getAttribute('data-variant-id');
      var p = btn.getAttribute('data-price');
      var c = btn.getAttribute('data-compare');
      priceEls.forEach(function (el) { el.textContent = p; });
      compareEls.forEach(function (el) { el.textContent = c || ''; });
      ctaPriceEls.forEach(function (el) { el.textContent = p; });
    }
    tiers.forEach(function (t) {
      t.addEventListener('click', function () { selectTier(t); });
      if (t.getAttribute('aria-pressed') === 'true') selectTier(t);
    });

    root.querySelectorAll('[data-cp-atc]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!selectedVariant) {
          var first = root.querySelector('[data-cp-tier]');
          if (first) selectTier(first);
        }
        if (!selectedVariant) return;
        btn.disabled = true;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: parseInt(selectedVariant, 10), quantity: 1 }] })
        }).then(function (r) {
          btn.disabled = false;
          if (r.ok) { window.location.href = '/cart'; }
        }).catch(function () { btn.disabled = false; });
      });
    });

    var sticky = root.querySelector('[data-cp-sticky]');
    var heroCta = root.querySelector('.cp-buybox .cp-cta');
    if (sticky && heroCta && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        sticky.classList.toggle('is-visible', !entries[0].isIntersecting && entries[0].boundingClientRect.top < 0);
      }, { threshold: 0 }).observe(heroCta);
    }
  })();
</script>

