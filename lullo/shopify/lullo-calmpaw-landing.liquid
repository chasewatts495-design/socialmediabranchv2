{% comment %}
  ============================================================
  LULLO — CalmPaw Plus Landing Section (lullo-calmpaw-landing)
  ------------------------------------------------------------
  Shopify Online Store 2.0 section for the Horizon theme.
  - Mobile-first: sticky bottom buy bar, full-width tier cards,
    48px+ tap targets, 17px minimum body text, no accordions,
    FAQ fully expanded (audience 25–90).
  - Brand: Fredoka, forest green #1f6b43 + cream palette from
    the live lullo.us, with schema-adjustable spa/botanical
    accents (leaf divider, sage wash).
  - Every visible string, price, color, and font is editable in
    the Shopify customizer (settings + blocks). No code edits
    needed to change copy.
  - Review/testimonial blocks ship HIDDEN by default — populate
    with real customer reviews, then enable.
  Install: save as sections/lullo-calmpaw-landing.liquid, then
  add the section to a template in the customizer.
  ============================================================
{% endcomment %}

{%- assign product = section.settings.product -%}

{%- style -%}
  .lullo-cp {
    --cp-green: {{ section.settings.color_primary }};
    --cp-green-deep: {{ section.settings.color_deep }};
    --cp-text: {{ section.settings.color_text }};
    --cp-cream: {{ section.settings.color_cream }};
    --cp-cream-2: {{ section.settings.color_cream_2 }};
    --cp-sage: {{ section.settings.color_spa_sage }};
    --cp-gold: {{ section.settings.color_gold }};
    --cp-badge: {{ section.settings.color_badge }};
    --cp-heading-font: {{ section.settings.font_heading.family }}, {{ section.settings.font_heading.fallback_families }};
    --cp-body-font: {{ section.settings.font_body.family }}, {{ section.settings.font_body.fallback_families }};
    --cp-body-size: {{ section.settings.body_size }}px;
    font-family: var(--cp-body-font);
    font-size: var(--cp-body-size);
    line-height: 1.6;
    color: var(--cp-text);
    background: #ffffff;
  }
  {{ section.settings.font_heading | font_face }}
  {{ section.settings.font_body | font_face }}

  .lullo-cp * { box-sizing: border-box; }
  .lullo-cp .cp-wrap { max-width: 1080px; margin: 0 auto; padding: 0 18px; }
  .lullo-cp h1, .lullo-cp h2, .lullo-cp h3 {
    font-family: var(--cp-heading-font);
    color: var(--cp-green-deep);
    line-height: 1.15;
    margin: 0 0 14px;
  }
  .lullo-cp h1 { font-size: clamp(30px, 6vw, 44px); font-weight: 700; }
  .lullo-cp h2 { font-size: clamp(25px, 5vw, 34px); font-weight: 600; }
  .lullo-cp h3 { font-size: clamp(20px, 4vw, 24px); font-weight: 600; }
  .lullo-cp p { margin: 0 0 14px; }
  .lullo-cp .cp-lead { font-weight: 700; }
  .lullo-cp section { padding: 44px 0; }

  /* Announcement bar */
  .lullo-cp .cp-announce {
    background: var(--cp-green);
    color: #fff;
    text-align: center;
    font-weight: 600;
    padding: 12px 14px;
    font-size: calc(var(--cp-body-size) - 1px);
    letter-spacing: .2px;
  }

  /* Spa leaf divider */
  .lullo-cp .cp-leaf-divider { text-align: center; padding: 6px 0 0; color: var(--cp-sage); }
  .lullo-cp .cp-leaf-divider svg { width: 84px; height: 22px; opacity: .9; }

  /* Hero */
  .lullo-cp .cp-hero { background: linear-gradient(180deg, var(--cp-cream) 0%, #ffffff 100%); padding-top: 30px; }
  .lullo-cp .cp-hero-grid { display: grid; gap: 26px; }
  @media (min-width: 880px) { .lullo-cp .cp-hero-grid { grid-template-columns: 1fr 1fr; align-items: start; } }
  .lullo-cp .cp-eyebrow {
    display: inline-block; background: var(--cp-sage); color: var(--cp-green-deep);
    border-radius: 99px; padding: 8px 18px; font-weight: 600;
    font-size: calc(var(--cp-body-size) - 2px); margin-bottom: 14px;
  }
  .lullo-cp .cp-hero-media img { width: 100%; border-radius: 16px; display: block; }
  .lullo-cp .cp-hero-media { position: relative; }
  .lullo-cp .cp-save-flag {
    position: absolute; top: 14px; left: 14px; background: var(--cp-badge); color: #fff;
    border-radius: 99px; padding: 8px 16px; font-weight: 700; font-size: calc(var(--cp-body-size) - 2px);
  }
  .lullo-cp .cp-price-row { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin: 10px 0 4px; }
  .lullo-cp .cp-price { font-family: var(--cp-heading-font); font-size: 34px; font-weight: 700; color: var(--cp-green-deep); }
  .lullo-cp .cp-compare { text-decoration: line-through; opacity: .55; font-size: 21px; }
  .lullo-cp .cp-save-pill { background: var(--cp-badge); color: #fff; border-radius: 99px; padding: 5px 14px; font-weight: 700; font-size: calc(var(--cp-body-size) - 3px); }
  .lullo-cp .cp-bullets { list-style: none; padding: 0; margin: 16px 0; }
  .lullo-cp .cp-bullets li { padding: 7px 0 7px 2px; display: flex; gap: 10px; align-items: flex-start; }
  .lullo-cp .cp-bullets .cp-bullet-ico { flex: 0 0 auto; font-size: 19px; line-height: 1.4; }

  /* Tier cards */
  .lullo-cp .cp-tiers { display: grid; gap: 12px; margin: 18px 0; }
  .lullo-cp .cp-tier {
    position: relative; width: 100%; text-align: left; cursor: pointer;
    border: 2px solid var(--cp-cream-2); border-radius: 16px; background: #fff;
    padding: 16px 16px 14px; min-height: 64px; font: inherit; color: inherit;
  }
  .lullo-cp .cp-tier[aria-pressed="true"] { border-color: var(--cp-green); background: var(--cp-cream); box-shadow: 0 0 0 2px var(--cp-green) inset; }
  .lullo-cp .cp-tier-badge {
    position: absolute; top: -12px; left: 14px; background: var(--cp-green); color: #fff;
    border-radius: 99px; padding: 4px 12px; font-size: calc(var(--cp-body-size) - 4px); font-weight: 700;
  }
  .lullo-cp .cp-tier-name { font-weight: 700; display: block; padding-right: 90px; }
  .lullo-cp .cp-tier-save { color: var(--cp-green); font-weight: 600; font-size: calc(var(--cp-body-size) - 2px); }
  .lullo-cp .cp-tier-prices { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); text-align: right; }
  .lullo-cp .cp-tier-price { font-family: var(--cp-heading-font); font-weight: 700; font-size: 21px; color: var(--cp-green-deep); display: block; }
  .lullo-cp .cp-tier-compare { text-decoration: line-through; opacity: .55; font-size: calc(var(--cp-body-size) - 2px); }
  .lullo-cp .cp-tier-note { font-style: italic; font-size: calc(var(--cp-body-size) - 2px); opacity: .85; margin: 2px 0 0; }

  /* CTA */
  .lullo-cp .cp-cta,
  .lullo-cp .cp-sticky-cta {
    display: block; width: 100%; text-align: center; border: 0; cursor: pointer;
    background: var(--cp-green); color: #fff; border-radius: 14px;
    padding: 17px 42px; font-family: var(--cp-heading-font);
    font-size: calc(var(--cp-body-size) + 2px); font-weight: 700; letter-spacing: .3px;
    min-height: 56px;
  }
  .lullo-cp .cp-cta:hover, .lullo-cp .cp-sticky-cta:hover { filter: brightness(.93); }
  .lullo-cp .cp-ebook-flag {
    background: var(--cp-cream-2); border: 1px dashed var(--cp-green);
    border-radius: 14px; padding: 13px 15px; margin: 14px 0; font-size: calc(var(--cp-body-size) - 1px);
  }
  .lullo-cp .cp-trust-lines { margin: 14px 0 0; }
  .lullo-cp .cp-trust-lines p { margin: 0 0 10px; font-size: calc(var(--cp-body-size) - 1px); }

  /* Sticky mobile buy bar */
  .lullo-cp-sticky {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
    background: #fff; border-top: 2px solid var(--cp-cream-2);
    padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
    display: flex; gap: 12px; align-items: center;
    transform: translateY(110%); transition: transform .25s ease;
  }
  .lullo-cp-sticky.is-visible { transform: translateY(0); }
  .lullo-cp-sticky .cp-sticky-price { font-family: var(--cp-heading-font); font-weight: 700; color: var(--cp-green-deep); font-size: 19px; white-space: nowrap; }
  .lullo-cp-sticky .cp-sticky-compare { text-decoration: line-through; opacity: .55; font-size: 14px; display: block; }
  .lullo-cp-sticky .cp-sticky-cta { flex: 1; padding: 14px 18px; min-height: 52px; }

  /* Generic tinted sections */
  .lullo-cp .cp-tint { background: var(--cp-cream); }
  .lullo-cp .cp-tint-sage { background: linear-gradient(180deg, #fff 0%, var(--cp-sage) 140%); }
  .lullo-cp .cp-dark { background: var(--cp-green-deep); color: #fff; }
  .lullo-cp .cp-dark h2, .lullo-cp .cp-dark h3 { color: #fff; }

  /* Cards */
  .lullo-cp .cp-cards { display: grid; gap: 16px; margin-top: 22px; }
  @media (min-width: 760px) { .lullo-cp .cp-cards { grid-template-columns: repeat(3, 1fr); } }
  .lullo-cp .cp-card { background: #fff; border: 1px solid var(--cp-cream-2); border-radius: 16px; padding: 22px 20px; }
  .lullo-cp .cp-card h3 { margin-bottom: 8px; }

  /* Benefit icons */
  .lullo-cp .cp-icons { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-top: 22px; }
  @media (min-width: 760px) { .lullo-cp .cp-icons { grid-template-columns: repeat(4, 1fr); } }
  .lullo-cp .cp-icon-item { background: var(--cp-cream); border-radius: 16px; padding: 20px 14px; text-align: center; font-weight: 600; }
  .lullo-cp .cp-icon-item .cp-ico { font-size: 30px; display: block; margin-bottom: 8px; }

  /* Features */
  .lullo-cp .cp-feature { display: grid; gap: 18px; align-items: center; padding: 26px 0; border-bottom: 1px solid var(--cp-cream-2); }
  @media (min-width: 820px) {
    .lullo-cp .cp-feature { grid-template-columns: 1fr 1fr; }
    .lullo-cp .cp-feature:nth-child(even) .cp-feature-media { order: 2; }
  }
  .lullo-cp .cp-feature-media img { width: 100%; border-radius: 16px; display: block; }
  .lullo-cp .cp-feature-media .cp-media-ph {
    background: var(--cp-sage); border-radius: 16px; min-height: 210px;
    display: flex; align-items: center; justify-content: center; font-size: 52px;
  }
  .lullo-cp .cp-feature-num { color: var(--cp-green); font-weight: 700; letter-spacing: .12em; font-size: calc(var(--cp-body-size) - 3px); }

  /* Reviews */
  .lullo-cp .cp-reviews { display: grid; gap: 16px; margin-top: 22px; }
  @media (min-width: 760px) { .lullo-cp .cp-reviews { grid-template-columns: repeat(2, 1fr); } }
  .lullo-cp .cp-review { background: #fff; border: 1px solid var(--cp-cream-2); border-radius: 16px; padding: 22px 20px; }
  .lullo-cp .cp-stars { color: var(--cp-gold); letter-spacing: 2px; margin-bottom: 6px; }
  .lullo-cp .cp-review-name { font-weight: 600; opacity: .8; margin-top: 8px; display: block; }

  /* Comparison table */
  .lullo-cp .cp-table-scroll { overflow-x: auto; margin-top: 22px; }
  .lullo-cp table.cp-compare-table { width: 100%; border-collapse: separate; border-spacing: 0; background: #fff; border-radius: 16px; overflow: hidden; border: 1px solid var(--cp-cream-2); min-width: 560px; }
  .lullo-cp .cp-compare-table th, .lullo-cp .cp-compare-table td { padding: 14px 14px; text-align: center; border-bottom: 1px solid var(--cp-cream-2); font-size: calc(var(--cp-body-size) - 1px); }
  .lullo-cp .cp-compare-table td:first-child { text-align: left; font-weight: 600; }
  .lullo-cp .cp-compare-table thead th { background: var(--cp-cream); font-family: var(--cp-heading-font); }
  .lullo-cp .cp-compare-table .cp-col-us { background: var(--cp-cream); color: var(--cp-green-deep); font-weight: 700; }
  .lullo-cp .cp-yes { color: var(--cp-green); font-weight: 700; }
  .lullo-cp .cp-no { color: #b3402f; font-weight: 700; }

  /* Video/proof */
  .lullo-cp .cp-video-frame { border-radius: 16px; overflow: hidden; margin-top: 20px; background: #000; }
  .lullo-cp .cp-video-frame video, .lullo-cp .cp-video-frame iframe { width: 100%; display: block; aspect-ratio: 16/9; border: 0; }

  /* Guarantee */
  .lullo-cp .cp-guarantee { border: 2px solid var(--cp-green); border-radius: 16px; background: var(--cp-cream); padding: 26px 22px; text-align: center; }
  .lullo-cp .cp-guarantee .cp-seal { font-size: 42px; display: block; margin-bottom: 8px; }

  /* FAQ — fully expanded, no accordions */
  .lullo-cp .cp-faq-item { background: #fff; border: 1px solid var(--cp-cream-2); border-radius: 16px; padding: 22px 20px; margin-top: 14px; }
  .lullo-cp .cp-faq-item h3 { color: var(--cp-green); }

  /* Bonus */
  .lullo-cp .cp-bonus { position: relative; background: #fff; border-radius: 16px; padding: 28px 22px; border: 1px solid var(--cp-cream-2); }
  .lullo-cp .cp-free-badge { position: absolute; top: -14px; right: 18px; background: var(--cp-badge); color: #fff; border-radius: 99px; padding: 6px 16px; font-weight: 700; }
  .lullo-cp .cp-bonus ol { padding-left: 22px; }
  .lullo-cp .cp-bonus li { margin-bottom: 8px; }
  .lullo-cp .cp-final-sub { text-align: center; margin-top: 12px; font-size: calc(var(--cp-body-size) - 1px); }
{%- endstyle -%}

<div class="lullo-cp" id="lullo-cp-{{ section.id }}">

  {% if section.settings.show_announcement %}
    <div class="cp-announce">{{ section.settings.announcement_text }}</div>
  {% endif %}

  {%- comment -%} ============ HERO / BUY BOX ============ {%- endcomment -%}
  <section class="cp-hero">
    <div class="cp-wrap">
      <div class="cp-hero-grid">
        <div class="cp-hero-media">
          {% if section.settings.hero_image %}
            <img src="{{ section.settings.hero_image | image_url: width: 1000 }}" alt="{{ section.settings.product_title | escape }}" loading="eager">
          {% else %}
            <div class="cp-media-ph" style="min-height:300px;border-radius:16px;background:var(--cp-sage);display:flex;align-items:center;justify-content:center;font-size:64px;">🐾</div>
          {% endif %}
          <span class="cp-save-flag">{{ section.settings.save_badge }}</span>
        </div>

        <div class="cp-buybox">
          <span class="cp-eyebrow">{{ section.settings.eyebrow }}</span>
          <h1>{{ section.settings.product_title }}</h1>
          <p>{{ section.settings.hero_subhead }}</p>

          <div class="cp-price-row">
            <span class="cp-price" data-cp-price>{{ section.settings.price_single }}</span>
            <span class="cp-compare" data-cp-compare>{{ section.settings.compare_single }}</span>
            <span class="cp-save-pill">{{ section.settings.save_badge }}</span>
          </div>

          <ul class="cp-bullets">
            {% for block in section.blocks %}
              {% if block.type == 'bullet' %}
                <li {{ block.shopify_attributes }}>
                  <span class="cp-bullet-ico">{{ block.settings.icon }}</span>
                  <span>{{ block.settings.text }}</span>
                </li>
              {% endif %}
            {% endfor %}
          </ul>

          <div class="cp-tiers" data-cp-tiers>
            {% for block in section.blocks %}
              {% if block.type == 'tier' %}
                <button type="button" class="cp-tier" {{ block.shopify_attributes }}
                  aria-pressed="{% if block.settings.preselected %}true{% else %}false{% endif %}"
                  data-cp-tier
                  data-variant-id="{{ block.settings.variant_id }}"
                  data-price="{{ block.settings.price }}"
                  data-compare="{{ block.settings.compare_at }}">
                  {% if block.settings.badge != blank %}<span class="cp-tier-badge">{{ block.settings.badge }}</span>{% endif %}
                  <span class="cp-tier-name">{{ block.settings.name }}</span>
                  <span class="cp-tier-save">{{ block.settings.save_line }}</span>
                  <span class="cp-tier-prices">
                    <span class="cp-tier-price">{{ block.settings.price }}</span>
                    <span class="cp-tier-compare">{{ block.settings.compare_at }}</span>
                  </span>
                </button>
              {% endif %}
            {% endfor %}
          </div>
          <p class="cp-tier-note">{{ section.settings.tier_note }}</p>

          <button type="button" class="cp-cta" data-cp-atc>{{ section.settings.cta_label }} — <span data-cp-cta-price>{{ section.settings.price_single }}</span></button>

          <div class="cp-ebook-flag">{{ section.settings.ebook_hero_text }}</div>

          <div class="cp-trust-lines">
            <p>{{ section.settings.shipping_line }}</p>
            <p>{{ section.settings.guarantee_line }}</p>
          </div>

          {% if section.settings.show_buybox_review and section.settings.buybox_review_text != blank %}
            <div class="cp-review" style="margin-top:16px;">
              <div class="cp-stars">★★★★★</div>
              <p>{{ section.settings.buybox_review_text }}</p>
              <span class="cp-review-name">{{ section.settings.buybox_review_name }}</span>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
    <div class="cp-leaf-divider" aria-hidden="true">
      <svg viewBox="0 0 120 30" fill="currentColor"><path d="M10 22 C30 6, 50 6, 60 15 C70 6, 90 6, 110 22 C90 16, 70 16, 60 20 C50 16, 30 16, 10 22 Z"/></svg>
    </div>
  </section>

  {%- comment -%} ============ AGITATION ============ {%- endcomment -%}
  <section class="cp-tint">
    <div class="cp-wrap">
      <h2>{{ section.settings.agitation_heading }}</h2>
      <div class="cp-cards">
        {% for block in section.blocks %}
          {% if block.type == 'agitation' %}
            <div class="cp-card" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.body }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {%- comment -%} ============ SOLUTION + ICONS ============ {%- endcomment -%}
  <section>
    <div class="cp-wrap" style="text-align:center;">
      <h2>{{ section.settings.solution_heading }}</h2>
      <p style="max-width:640px;margin:0 auto;">{{ section.settings.solution_sub }}</p>
      <div class="cp-icons">
        {% for block in section.blocks %}
          {% if block.type == 'icon' %}
            <div class="cp-icon-item" {{ block.shopify_attributes }}>
              <span class="cp-ico">{{ block.settings.icon }}</span>
              {{ block.settings.label }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {%- comment -%} ============ MECHANISM ============ {%- endcomment -%}
  <section class="cp-tint-sage">
    <div class="cp-wrap" style="max-width:760px;">
      <h2>{{ section.settings.mechanism_heading }}</h2>
      {{ section.settings.mechanism_body }}
    </div>
  </section>

  {%- comment -%} ============ FEATURES ============ {%- endcomment -%}
  <section>
    <div class="cp-wrap">
      <h2 style="text-align:center;">{{ section.settings.features_heading }}</h2>
      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
          <div class="cp-feature" {{ block.shopify_attributes }}>
            <div class="cp-feature-media">
              {% if block.settings.image %}
                <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {% else %}
                <div class="cp-media-ph">{{ block.settings.icon }}</div>
              {% endif %}
            </div>
            <div>
              <div class="cp-feature-num">{{ block.settings.eyebrow }}</div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.body }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  {%- comment -%} ============ REVIEWS (real only; hidden until populated) ============ {%- endcomment -%}
  {% assign has_reviews = false %}
  {% for block in section.blocks %}
    {% if block.type == 'review' and block.settings.enabled and block.settings.body != blank %}{% assign has_reviews = true %}{% endif %}
  {% endfor %}
  {% if has_reviews %}
    <section class="cp-tint">
      <div class="cp-wrap">
        <h2 style="text-align:center;">{{ section.settings.reviews_heading }}</h2>
        <div class="cp-reviews">
          {% for block in section.blocks %}
            {% if block.type == 'review' and block.settings.enabled and block.settings.body != blank %}
              <div class="cp-review" {{ block.shopify_attributes }}>
                <div class="cp-stars">★★★★★</div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.body }}</p>
                <span class="cp-review-name">{{ block.settings.name }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {%- comment -%} ============ COMPARISON TABLE ============ {%- endcomment -%}
  <section>
    <div class="cp-wrap">
      <h2 style="text-align:center;">{{ section.settings.compare_heading }}</h2>
      <p style="text-align:center;">{{ section.settings.compare_sub }}</p>
      <div class="cp-table-scroll">
        <table class="cp-compare-table">
          <thead>
            <tr>
              <th></th>
              <th class="cp-col-us">{{ section.settings.compare_col_us }}</th>
              <th>{{ section.settings.compare_col_a }}</th>
              <th>{{ section.settings.compare_col_b }}</th>
            </tr>
          </thead>
          <tbody>
            {% for block in section.blocks %}
              {% if block.type == 'comprow' %}
                <tr {{ block.shopify_attributes }}>
                  <td>{{ block.settings.label }}</td>
                  <td class="cp-col-us"><span class="cp-yes">{{ block.settings.us }}</span></td>
                  <td><span class="{% if block.settings.a contains '✗' %}cp-no{% endif %}">{{ block.settings.a }}</span></td>
                  <td><span class="{% if block.settings.b contains '✗' %}cp-no{% endif %}">{{ block.settings.b }}</span></td>
                </tr>
              {% endif %}
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {%- comment -%} ============ PROOF / DEMO VIDEO ============ {%- endcomment -%}
  <section class="cp-dark">
    <div class="cp-wrap" style="max-width:760px;text-align:center;">
      <h2>{{ section.settings.proof_heading }}</h2>
      <p>{{ section.settings.proof_sub }}</p>
      {% if section.settings.proof_video_url != blank %}
        <div class="cp-video-frame">
          <iframe src="{{ section.settings.proof_video_url }}" title="{{ section.settings.proof_heading | escape }}" allowfullscreen loading="lazy"></iframe>
        </div>
      {% endif %}
    </div>
