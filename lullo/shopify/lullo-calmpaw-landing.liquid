          <div class="cp-cards" data-cp-collect="problem"></div>
        </div>
      </div>

      {% when 'problem_card' %}
      <template data-cp-into="problem" {{ block.shopify_attributes }}>
        <div class="cp-card" style="text-align:left;">
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.body }}</p>
        </div>
      </template>

      {% when 'solution' %}
      <div class="cp-band" {{ block.shopify_attributes }}>
        <div class="cp-wrap cp-center">
          {% if block.settings.eyebrow != blank %}<span class="cp-eyebrow">{{ block.settings.eyebrow }}</span>{% endif %}
          <h2>{{ block.settings.heading }}</h2>
          <p class="cp-sub">{{ block.settings.subhead }}</p>
          <div class="cp-icongrid">
            {% assign items = block.settings.items | newline_to_br | split: '<br />' %}
            {% for item in items %}
              {% assign t = item | strip %}
              {% if t != blank %}<div class="cp-iconitem">{{ cp_check }}{{ t }}</div>{% endif %}
            {% endfor %}
          </div>
        </div>
      </div>

      {% when 'mechanism' %}
      <div class="cp-band cp-band--dark" {{ block.shopify_attributes }}>
        <div class="cp-wrap cp-wrap--narrow">
          {% if block.settings.eyebrow != blank %}<span class="cp-eyebrow">{{ block.settings.eyebrow }}</span>{% endif %}
          <h2>{{ block.settings.heading }}</h2>
          {{ block.settings.body }}
        </div>
      </div>

      {% when 'features_heading' %}
      <div class="cp-band" style="padding-bottom:0;" {{ block.shopify_attributes }}>
        <div class="cp-wrap cp-center">
          {% if block.settings.eyebrow != blank %}<span class="cp-eyebrow">{{ block.settings.eyebrow }}</span>{% endif %}
          <h2>{{ block.settings.heading }}</h2>
        </div>
      </div>

      {% when 'feature' %}
      <div class="cp-band" style="padding-top:0;padding-bottom:0;" {{ block.shopify_attributes }}>
        <div class="cp-wrap{% unless block.settings.image %} cp-wrap--narrow{% endunless %}">
          <div class="cp-feature{% if block.settings.image %}{% cycle ' ', ' cp-feature--flip' %}{% else %} cp-feature--noimg{% endif %}">
            {% if block.settings.image %}
              <div class="cp-feature-media">
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title }}
              </div>
            {% endif %}
            <div>
              <div class="cp-feature-num">{{ block.settings.eyebrow }}</div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.body }}</p>
            </div>
          </div>
        </div>
      </div>

      {% when 'compare' %}
      <div class="cp-band" {{ block.shopify_attributes }}>
        <div class="cp-wrap cp-center">
          {% if block.settings.eyebrow != blank %}<span class="cp-eyebrow">{{ block.settings.eyebrow }}</span>{% endif %}
          <h2>{{ block.settings.heading }}</h2>
          {% if block.settings.subhead != blank %}<p class="cp-sub">{{ block.settings.subhead }}</p>{% endif %}
          <div class="cp-table-scroll">
            <table class="cp-table">
              <thead>
                <tr>
                  <th></th>
                  <th class="cp-us">{{ block.settings.col_us }}</th>
                  <th>{{ block.settings.col_a }}</th>
                  <th>{{ block.settings.col_b }}</th>
                </tr>
              </thead>
              <tbody>
                {% assign rows = block.settings.rows | newline_to_br | split: '<br />' %}
                {% for row in rows %}
                  {% assign cells = row | strip | split: '|' %}
                  {% if cells.size >= 4 %}
                    <tr>
                      <td>{{ cells[0] | strip }}</td>
                      <td class="cp-us"><span class="cp-good">{{ cells[1] | strip }}</span></td>
                      <td>{% assign c = cells[2] | strip %}{% if c contains '✗' %}<span class="cp-badmark">{{ c }}</span>{% else %}{{ c }}{% endif %}</td>
                      <td>{% assign c = cells[3] | strip %}{% if c contains '✗' %}<span class="cp-badmark">{{ c }}</span>{% else %}{{ c }}{% endif %}</td>
                    </tr>
                  {% endif %}
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      {% when 'proof' %}
      <div class="cp-band cp-band--dark" {{ block.shopify_attributes }}>
        <div class="cp-wrap cp-wrap--narrow cp-center">
          {% if block.settings.eyebrow != blank %}<span class="cp-eyebrow">{{ block.settings.eyebrow }}</span>{% endif %}
          <h2>{{ block.settings.heading }}</h2>
          <p class="cp-sub">{{ block.settings.body }}</p>
