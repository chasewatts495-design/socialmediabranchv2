{% comment %}
  ============================================================
  LULLO — CalmPaw Plus Landing (v2, block-based)
  ------------------------------------------------------------
  ONE uploadable Shopify OS 2.0 section. Every page part is a
  reorderable block: drag to reorder, insert "Custom text" /
  "Custom Liquid" blocks between any two parts.
  - Backgrounds: white + off-black only. Green = accent only.
  - Fonts: headings Fredoka, body Open Sans (both font_picker).
  - No header, no sticky/floating elements, no reviews, no video
    by default. 30-day guarantee. Lullo CalmPaw Plus naming.
  Install: paste as sections/lullo-calmpaw-landing.liquid, add
  "Lullo CalmPaw Landing" to your product/landing template.
  Then set the two variant IDs in the Hero block settings.
  ============================================================
{% endcomment %}

{%- style -%}
  #lullo-cp-{{ section.id }} {
    --cp-accent: {{ section.settings.color_accent }};
    --cp-ink: {{ section.settings.color_ink }};
    --cp-line: #e3e3e0;
    --cp-bad: #b3402f;
    --cp-heading-font: {{ section.settings.font_heading.family }}, {{ section.settings.font_heading.fallback_families }};
    --cp-body-font: {{ section.settings.font_body.family }}, {{ section.settings.font_body.fallback_families }};
    font-family: var(--cp-body-font);
    font-size: {{ section.settings.body_size }}px;
    line-height: 1.65;
    color: var(--cp-ink);
    background: #ffffff;
  }
  {{ section.settings.font_heading | font_face }}
  {{ section.settings.font_body | font_face }}

  #lullo-cp-{{ section.id }} *, #lullo-cp-{{ section.id }} *::before, #lullo-cp-{{ section.id }} *::after { box-sizing: border-box; }
  #lullo-cp-{{ section.id }} .cp-band { padding: 56px 0; background: #ffffff; }
  #lullo-cp-{{ section.id }} .cp-band--dark { background: var(--cp-ink); color: #ffffff; }
  #lullo-cp-{{ section.id }} .cp-band--dark h2, #lullo-cp-{{ section.id }} .cp-band--dark h3 { color: #ffffff; }
  #lullo-cp-{{ section.id }} .cp-band--dark .cp-eyebrow { color: #8fd6ae; }
  #lullo-cp-{{ section.id }} .cp-wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
  #lullo-cp-{{ section.id }} .cp-wrap--narrow { max-width: 820px; }

  #lullo-cp-{{ section.id }} h1, #lullo-cp-{{ section.id }} h2 {
    font-family: var(--cp-heading-font); font-weight: 700;
    color: var(--cp-ink); line-height: 1.15; margin: 0 0 16px;
  }
  #lullo-cp-{{ section.id }} h1 { font-size: clamp(30px, 5.4vw, 42px); }
  #lullo-cp-{{ section.id }} .cp-title-suffix { font-family: var(--cp-body-font); font-weight: 600; font-size: 0.45em; color: var(--cp-accent); white-space: nowrap; letter-spacing: 0.02em; }
  #lullo-cp-{{ section.id }} .cp-rating { display: flex; align-items: center; gap: 8px; margin: 2px 0 12px; }
  #lullo-cp-{{ section.id }} .cp-rating .cp-stars { display: inline-flex; gap: 2px; }
  #lullo-cp-{{ section.id }} .cp-rating .cp-stars svg { width: 17px; height: 17px; display: block; }
  #lullo-cp-{{ section.id }} .cp-rating .cp-rating-text { font-size: 0.92em; font-weight: 600; }
  #lullo-cp-{{ section.id }} h2 { font-size: clamp(24px, 4.6vw, 32px); }
  #lullo-cp-{{ section.id }} h3 { font-family: var(--cp-body-font); font-weight: 700; font-size: 1.06em; color: var(--cp-ink); margin: 0 0 8px; }
  #lullo-cp-{{ section.id }} p { margin: 0 0 14px; }
  #lullo-cp-{{ section.id }} .cp-eyebrow {
    display: block; font-weight: 700; font-size: 0.78em; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--cp-accent); margin-bottom: 10px;
  }
  #lullo-cp-{{ section.id }} .cp-center { text-align: center; }
  #lullo-cp-{{ section.id }} .cp-sub { max-width: 640px; margin: 0 auto 8px; }

  /* Buttons — in flow only */
  #lullo-cp-{{ section.id }} .cp-cta {
    display: block; width: 100%; text-align: center; border: 0; cursor: pointer;
    background: var(--cp-accent); color: #fff; border-radius: 12px;
    padding: 17px 32px; font-family: var(--cp-body-font);
    font-size: 1.06em; font-weight: 700; letter-spacing: .02em; min-height: 56px;
  }
  #lullo-cp-{{ section.id }} .cp-cta:hover { filter: brightness(.92); }

  /* Hero */
  #lullo-cp-{{ section.id }} .cp-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 26px; align-items: start; }
  /* Mobile order: title → image → buy box → info panels (Heusom-style) */
  #lullo-cp-{{ section.id }} .cp-mobile-head { order: 1; }
  #lullo-cp-{{ section.id }} .cp-hero-media { order: 2; }
  #lullo-cp-{{ section.id }} .cp-buybox { order: 3; }
  #lullo-cp-{{ section.id }} .cp-under-image { order: 4; }
  #lullo-cp-{{ section.id }} .cp-buybox .cp-head-group { display: none; }
  @media (min-width: 900px) {
    #lullo-cp-{{ section.id }} .cp-hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: min-content 1fr; gap: 32px; }
    #lullo-cp-{{ section.id }} .cp-under-image { align-self: start; margin-top: 0; }
    #lullo-cp-{{ section.id }} .cp-mobile-head { display: none; }
    #lullo-cp-{{ section.id }} .cp-hero-media { order: 0; grid-column: 1; grid-row: 1; }
    #lullo-cp-{{ section.id }} .cp-under-image { order: 0; grid-column: 1; grid-row: 2; }
    #lullo-cp-{{ section.id }} .cp-buybox { order: 0; grid-column: 2; grid-row: 1 / span 2; }
    #lullo-cp-{{ section.id }} .cp-buybox .cp-head-group { display: block; }
  }
  #lullo-cp-{{ section.id }} .cp-hero-media { position: relative; }
  #lullo-cp-{{ section.id }} .cp-hero-media img { width: 100%; border-radius: 14px; display: block; border: 1px solid var(--cp-line); }
  #lullo-cp-{{ section.id }} .cp-hero-ph { border: 1px solid var(--cp-line); border-radius: 14px; min-height: 320px; display: flex; align-items: center; justify-content: center; color: #9a9a95; font-size: 0.9em; }
  #lullo-cp-{{ section.id }} .cp-under-image { margin-top: 22px; display: grid; gap: 12px; }
  #lullo-cp-{{ section.id }} .cp-under-panel { border: 1px solid var(--cp-line); border-radius: 12px; padding: 18px 18px; }
  #lullo-cp-{{ section.id }} .cp-under-panel h3 { font-family: var(--cp-heading-font); font-size: 1.15em; margin-bottom: 6px; }
  #lullo-cp-{{ section.id }} .cp-under-panel p { margin-bottom: 0; font-size: 0.95em; }
  #lullo-cp-{{ section.id }} .cp-under-tiles { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 12px; }
  #lullo-cp-{{ section.id }} .cp-under-tile { border: 1px solid var(--cp-line); border-radius: 12px; padding: 14px 10px; text-align: center; }
  #lullo-cp-{{ section.id }} .cp-under-tile b { display: block; font-family: var(--cp-heading-font); color: var(--cp-accent); font-size: 1.05em; margin-bottom: 3px; }
  #lullo-cp-{{ section.id }} .cp-under-tile span { font-size: 0.82em; line-height: 1.35; display: block; }
  #lullo-cp-{{ section.id }} .cp-save-flag {
    position: absolute; top: 12px; left: 12px; background: var(--cp-bad); color: #fff;
    border-radius: 8px; padding: 6px 12px; font-weight: 700; font-size: 0.82em;
  }
  #lullo-cp-{{ section.id }} .cp-price-row { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin: 4px 0 10px; }
  #lullo-cp-{{ section.id }} .cp-price { font-family: var(--cp-heading-font); font-size: 1.9em; font-weight: 700; color: var(--cp-accent); }
  #lullo-cp-{{ section.id }} .cp-compare { text-decoration: line-through; color: #6f6f6a; font-size: 1.15em; }
  #lullo-cp-{{ section.id }} .cp-save-pill { background: var(--cp-bad); color: #fff; border-radius: 8px; padding: 4px 10px; font-weight: 700; font-size: 0.8em; }

  #lullo-cp-{{ section.id }} .cp-bullets { list-style: none; padding: 0; margin: 14px 0 18px; }
  #lullo-cp-{{ section.id }} .cp-bullets li { display: flex; gap: 10px; align-items: flex-start; padding: 6px 0; }
  #lullo-cp-{{ section.id }} .cp-check { flex: 0 0 18px; margin-top: 5px; }
  #lullo-cp-{{ section.id }} .cp-check svg { display: block; width: 18px; height: 18px; }

  /* Tier cards — flex rows, nothing absolute */
  #lullo-cp-{{ section.id }} .cp-tiers { display: grid; gap: 12px; margin: 6px 0 16px; }
  #lullo-cp-{{ section.id }} .cp-tier {
    width: 100%; cursor: pointer; text-align: left; font: inherit; color: inherit;
    border: 2px solid var(--cp-line); border-radius: 12px; background: #fff; padding: 14px 16px;
  }
  #lullo-cp-{{ section.id }} .cp-tier[aria-pressed="true"] { border-color: var(--cp-accent); box-shadow: 0 0 0 1.5px var(--cp-accent) inset; }
  #lullo-cp-{{ section.id }} .cp-tier-badge {
    display: inline-block; background: var(--cp-accent); color: #fff;
    border-radius: 8px; padding: 3px 10px; font-size: 0.74em; font-weight: 700;
    letter-spacing: .04em; margin-bottom: 8px;
  }
  #lullo-cp-{{ section.id }} .cp-tier-row { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; }
  #lullo-cp-{{ section.id }} .cp-tier-name { font-weight: 700; }
  #lullo-cp-{{ section.id }} .cp-tier-price { font-family: var(--cp-heading-font); font-weight: 700; font-size: 1.25em; color: var(--cp-accent); white-space: nowrap; }
  #lullo-cp-{{ section.id }} .cp-tier-row2 { display: flex; justify-content: space-between; gap: 14px; margin-top: 2px; font-size: 0.9em; }
  #lullo-cp-{{ section.id }} .cp-tier-save { color: var(--cp-accent); font-weight: 600; }
  #lullo-cp-{{ section.id }} .cp-tier-compare { text-decoration: line-through; color: #6f6f6a; white-space: nowrap; }

  #lullo-cp-{{ section.id }} .cp-ebook-flag {
    display: flex; align-items: center; gap: 14px;
    background: var(--cp-accent); color: #fff; border-radius: 12px;
    padding: 14px 16px; margin: 14px 0; font-size: 0.95em;
  }
  #lullo-cp-{{ section.id }} .cp-ebook-flag img {
    flex: 0 0 74px; width: 74px; height: 74px; object-fit: contain;
    background: #fff; border-radius: 10px; display: block;
  }
  #lullo-cp-{{ section.id }} .cp-ebook-flag .cp-ebook-title {
    display: block; font-weight: 700; font-size: 1.05em; margin-bottom: 3px;
  }
  #lullo-cp-{{ section.id }} .cp-ebook-flag .cp-ebook-badge {
    display: inline-block; background: #fff; color: var(--cp-accent);
    border-radius: 6px; padding: 1px 8px; font-weight: 700; font-size: 0.78em;
    letter-spacing: .05em; margin-right: 6px; vertical-align: 1px;
  }
  #lullo-cp-{{ section.id }} .cp-trust { margin: 4px 0 0; }
  #lullo-cp-{{ section.id }} .cp-trust p { margin: 0 0 8px; font-size: 0.95em; }

  /* Cards / grids */
  #lullo-cp-{{ section.id }} .cp-cards { display: grid; gap: 16px; margin-top: 26px; }
  @media (min-width: 760px) { #lullo-cp-{{ section.id }} .cp-cards { grid-template-columns: repeat(3, 1fr); } }
  #lullo-cp-{{ section.id }} .cp-card { border: 1px solid var(--cp-line); border-radius: 14px; padding: 22px 20px; background: #fff; }
  #lullo-cp-{{ section.id }} .cp-card p { margin-bottom: 0; font-size: 0.97em; }

  #lullo-cp-{{ section.id }} .cp-icongrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-top: 26px; }
  @media (min-width: 760px) { #lullo-cp-{{ section.id }} .cp-icongrid { grid-template-columns: repeat(4, 1fr); } }
  #lullo-cp-{{ section.id }} .cp-iconitem { border: 1px solid var(--cp-line); border-radius: 14px; padding: 18px 14px; text-align: center; font-weight: 600; font-size: 0.95em; }
  #lullo-cp-{{ section.id }} .cp-iconitem .cp-check { margin: 0 auto 8px; }

  /* Feature rows */
  #lullo-cp-{{ section.id }} .cp-feature { display: grid; grid-template-columns: minmax(0, 1fr); gap: 22px; align-items: center; padding: 30px 0; border-bottom: 1px solid var(--cp-line); }
  #lullo-cp-{{ section.id }} .cp-feature:last-of-type { border-bottom: 0; }
  @media (min-width: 860px) {
    #lullo-cp-{{ section.id }} .cp-feature { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    #lullo-cp-{{ section.id }} .cp-feature--flip .cp-feature-media { order: 2; }
    #lullo-cp-{{ section.id }} .cp-feature--noimg { grid-template-columns: 1fr; }
  }
  #lullo-cp-{{ section.id }} .cp-feature-media img { width: 100%; border-radius: 14px; display: block; border: 1px solid var(--cp-line); }
  #lullo-cp-{{ section.id }} .cp-feature-num { font-weight: 700; font-size: 0.78em; letter-spacing: 0.14em; color: var(--cp-accent); text-transform: uppercase; margin-bottom: 8px; }
  #lullo-cp-{{ section.id }} .cp-feature h3 { font-family: var(--cp-heading-font); font-size: 1.35em; }
  #lullo-cp-{{ section.id }} .cp-feature p { margin-bottom: 0; }

  /* Comparison table */
  #lullo-cp-{{ section.id }} .cp-table-scroll { overflow-x: auto; margin-top: 26px; }
  #lullo-cp-{{ section.id }} table.cp-table { width: 100%; min-width: 560px; border-collapse: separate; border-spacing: 0; border: 1px solid var(--cp-line); border-radius: 14px; overflow: hidden; }
  #lullo-cp-{{ section.id }} .cp-table th, #lullo-cp-{{ section.id }} .cp-table td { padding: 13px 14px; text-align: center; border-bottom: 1px solid var(--cp-line); font-size: 0.95em; background: #fff; }
  #lullo-cp-{{ section.id }} .cp-table tr:last-child td { border-bottom: 0; }
  #lullo-cp-{{ section.id }} .cp-table td:first-child { text-align: left; font-weight: 600; }
  #lullo-cp-{{ section.id }} .cp-table thead th { font-family: var(--cp-heading-font); font-weight: 700; }
  #lullo-cp-{{ section.id }} .cp-table .cp-us { background: var(--cp-ink); color: #fff; }
  #lullo-cp-{{ section.id }} .cp-good { color: var(--cp-accent); font-weight: 700; }
  #lullo-cp-{{ section.id }} .cp-table .cp-us .cp-good { color: #8fd6ae; }
  #lullo-cp-{{ section.id }} .cp-badmark { color: var(--cp-bad); font-weight: 700; }

  /* Guarantee */
  #lullo-cp-{{ section.id }} .cp-guarantee { border: 2px solid var(--cp-accent); border-radius: 14px; padding: 30px 26px; text-align: center; }
  #lullo-cp-{{ section.id }} .cp-seal { width: 44px; height: 44px; margin: 0 auto 12px; }
  #lullo-cp-{{ section.id }} .cp-seal svg { width: 100%; height: 100%; }

  /* FAQ */
  #lullo-cp-{{ section.id }} .cp-faq { border: 1px solid var(--cp-line); border-radius: 14px; padding: 22px 22px; margin-top: 14px; }
  #lullo-cp-{{ section.id }} .cp-faq h3 { color: var(--cp-accent); font-size: 1.05em; }
  #lullo-cp-{{ section.id }} .cp-faq p:last-child { margin-bottom: 0; }

  /* Bonus */
  #lullo-cp-{{ section.id }} .cp-bonus { border: 1px solid var(--cp-line); border-radius: 14px; padding: 30px 26px; position: relative; }
  #lullo-cp-{{ section.id }} .cp-free-badge { display: inline-block; background: var(--cp-accent); color: #fff; border-radius: 8px; padding: 4px 12px; font-weight: 700; font-size: 0.8em; letter-spacing: .05em; margin-bottom: 12px; }
  #lullo-cp-{{ section.id }} .cp-bonus ol { padding-left: 22px; margin: 0 0 20px; }
  #lullo-cp-{{ section.id }} .cp-bonus li { margin-bottom: 8px; }
  #lullo-cp-{{ section.id }} .cp-final-sub { text-align: center; margin: 12px 0 0; font-size: 0.92em; }
{%- endstyle -%}

{%- capture cp_check -%}
<span class="cp-check" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" fill="{{ section.settings.color_accent }}"/><path d="M6 10.5l2.5 2.5L14 7.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
{%- endcapture -%}

<div id="lullo-cp-{{ section.id }}">
  {% for block in section.blocks %}
    {% case block.type %}

      {% when 'hero' %}
      {%- capture cp_rating -%}
{% if block.settings.rating_text != blank %}<div class="cp-rating"><span class="cp-stars">{% for i in (1..5) %}<svg viewBox="0 0 20 20"><path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z" fill="{{ section.settings.color_gold | default: '#f2a900' }}"/></svg>{% endfor %}</span><span class="cp-rating-text">{{ block.settings.rating_text }}</span></div>{% endif %}
{%- endcapture -%}
      <div class="cp-band" {{ block.shopify_attributes }}>
        <div class="cp-wrap">
          <div class="cp-hero-grid">
            <div class="cp-mobile-head">
              {% if block.settings.eyebrow != blank %}<span class="cp-eyebrow">{{ block.settings.eyebrow }}</span>{% endif %}
              <h1>{{ block.settings.title }}{% if block.settings.title_suffix != blank %} <span class="cp-title-suffix">{{ block.settings.title_suffix }}</span>{% endif %}</h1>
              {{ cp_rating }}
              <p style="margin-bottom:0;">{{ block.settings.subhead }}</p>
            </div>
            <div class="cp-hero-media">
              {% if block.settings.image %}
                {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'eager', alt: block.settings.title }}
              {% else %}
                <div class="cp-hero-ph">Product image</div>
              {% endif %}
              {% if block.settings.save_badge != blank %}<span class="cp-save-flag">{{ block.settings.save_badge }}</span>{% endif %}
            </div>
            <div class="cp-under-image">
                {% if block.settings.under_tiles != blank %}
                  <div class="cp-under-tiles">
                    {% assign tiles = block.settings.under_tiles | newline_to_br | split: '<br />' %}
                    {% for tile in tiles %}
                      {% assign t = tile | strip %}
                      {% if t != blank %}
                        {% assign tparts = t | split: '|' %}
                        <div class="cp-under-tile"><b>{{ tparts[0] | strip }}</b><span>{{ tparts[1] | strip }}</span></div>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
                {% if block.settings.under_heading != blank or block.settings.under_text != blank %}
                  <div class="cp-under-panel">
                    {% if block.settings.under_heading != blank %}<h3>{{ block.settings.under_heading }}</h3>{% endif %}
                    {% if block.settings.under_text != blank %}<p>{{ block.settings.under_text }}</p>{% endif %}
                  </div>
                {% endif %}
                {% if block.settings.under_text_2 != blank %}
                  <div class="cp-under-panel"><p>{{ block.settings.under_text_2 }}</p></div>
                {% endif %}
              </div>
            <div class="cp-buybox">
              <div class="cp-head-group">
                {% if block.settings.eyebrow != blank %}<span class="cp-eyebrow">{{ block.settings.eyebrow }}</span>{% endif %}
                <h1>{{ block.settings.title }}{% if block.settings.title_suffix != blank %} <span class="cp-title-suffix">{{ block.settings.title_suffix }}</span>{% endif %}</h1>
                {{ cp_rating }}
                <p>{{ block.settings.subhead }}</p>
              </div>
              <div class="cp-price-row">
                <span class="cp-price" data-cp-price>{{ block.settings.tier1_price }}</span>
                <span class="cp-compare" data-cp-compare>{{ block.settings.tier1_compare }}</span>
                {% if block.settings.save_badge != blank %}<span class="cp-save-pill">{{ block.settings.save_badge }}</span>{% endif %}
              </div>
              <ul class="cp-bullets">
                {% assign lines = block.settings.bullets | newline_to_br | split: '<br />' %}
                {% for line in lines %}
                  {% assign t = line | strip %}
                  {% if t != blank %}<li>{{ cp_check }}<span>{{ t }}</span></li>{% endif %}
                {% endfor %}
              </ul>
              <div class="cp-tiers" data-cp-tiers>
                <button type="button" class="cp-tier" aria-pressed="true" data-cp-tier
                  data-variant-id="{{ block.settings.tier1_variant }}" data-price="{{ block.settings.tier1_price }}" data-compare="{{ block.settings.tier1_compare }}">
                  <span class="cp-tier-row"><span class="cp-tier-name">{{ block.settings.tier1_name }}</span><span class="cp-tier-price">{{ block.settings.tier1_price }}</span></span>
                  <span class="cp-tier-row2"><span class="cp-tier-save">{{ block.settings.tier1_save }}</span><span class="cp-tier-compare">{{ block.settings.tier1_compare }}</span></span>
                </button>
                <button type="button" class="cp-tier" aria-pressed="false" data-cp-tier
                  data-variant-id="{{ block.settings.tier2_variant }}" data-price="{{ block.settings.tier2_price }}" data-compare="{{ block.settings.tier2_compare }}">
                  {% if block.settings.tier2_badge != blank %}<span class="cp-tier-badge">{{ block.settings.tier2_badge }}</span>{% endif %}
                  <span class="cp-tier-row"><span class="cp-tier-name">{{ block.settings.tier2_name }}</span><span class="cp-tier-price">{{ block.settings.tier2_price }}</span></span>
                  <span class="cp-tier-row2"><span class="cp-tier-save">{{ block.settings.tier2_save }}</span><span class="cp-tier-compare">{{ block.settings.tier2_compare }}</span></span>
                </button>
              </div>
              <button type="button" class="cp-cta" data-cp-atc>{{ block.settings.cta_label }}</button>
              {% if block.settings.ebook_text != blank %}
                <div class="cp-ebook-flag">
                  {% if block.settings.ebook_image %}
                    {{ block.settings.ebook_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.ebook_title }}
                  {% endif %}
                  <div>
                    <span class="cp-ebook-title"><span class="cp-ebook-badge">{{ block.settings.ebook_badge }}</span>{{ block.settings.ebook_title }}</span>
                    {{ block.settings.ebook_text }}
                  </div>
                </div>
              {% endif %}
              <div class="cp-trust">
                <p><strong>Shipping:</strong> {{ block.settings.shipping_line }}</p>
                <p><strong>{{ block.settings.guarantee_title }}:</strong> {{ block.settings.guarantee_line }}</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      {% when 'problem_intro' %}
      <div class="cp-band" {{ block.shopify_attributes }}>
        <div class="cp-wrap cp-center">
          {% if block.settings.eyebrow != blank %}<span class="cp-eyebrow">{{ block.settings.eyebrow }}</span>{% endif %}
